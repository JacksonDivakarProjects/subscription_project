{
  "datasets": [
    {
      "name": "4d8ecda4",
      "displayName": "MRR Upgrades vs Losses",
      "queryLines": [
        "SELECT\n",
        "  Month,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN close_status = 'Won' THEN mrr_in_gpb\n",
        "        ELSE 0\n",
        "      END\n",
        "    ),\n",
        "    2\n",
        "  ) AS upselling_mrr,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN close_status = 'Lost' THEN mrr_in_gpb\n",
        "        ELSE 0\n",
        "      END\n",
        "    ),\n",
        "    2\n",
        "  ) AS downselling_mrr\n",
        "FROM\n",
        "  subscription_analytics\n",
        "GROUP BY\n",
        "  Month\n",
        "ORDER BY\n",
        "  Month"
      ],
      "catalog": "subscription_catalog",
      "schema": "gold"
    },
    {
      "name": "33138118",
      "displayName": "Subscription Analytics",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  subscription_analytics"
      ],
      "catalog": "subscription_catalog",
      "schema": "gold"
    },
    {
      "name": "2823242b",
      "displayName": "Rolling 12-Month MRR",
      "queryLines": [
        "SELECT\n",
        "  Month,\n",
        "  SUM(mrr_in_gpb) AS monthly_mrr,\n",
        "  SUM(SUM(mrr_in_gpb)) OVER (\n",
        "      ORDER BY Month\n",
        "      ROWS BETWEEN 11 PRECEDING AND CURRENT ROW\n",
        "    ) AS rolling_12_month_mrr\n",
        "FROM\n",
        "  subscription_analytics\n",
        "GROUP BY\n",
        "  Month\n",
        "ORDER BY\n",
        "  Month"
      ],
      "catalog": "subscription_catalog",
      "schema": "gold"
    },
    {
      "name": "359fe324",
      "displayName": "Top Downselling Customers",
      "queryLines": [
        "WITH customer_events AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    Month,\n",
        "    COUNT(DISTINCT product_id) AS product_count\n",
        "  FROM\n",
        "    subscription_analytics\n",
        "  WHERE\n",
        "    close_status = 'Lost'\n",
        "  GROUP BY\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    Month\n",
        "),\n",
        "downselling_per_month AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    Month,\n",
        "    SUM(product_count) OVER (\n",
        "        PARTITION BY customer_id, customer_name\n",
        "        ORDER BY Month\n",
        "      ) AS total_products_reduced,\n",
        "    ROW_NUMBER() OVER (PARTITION BY customer_id, customer_name ORDER BY Month DESC) AS rn\n",
        "  FROM\n",
        "    customer_events\n",
        ")\n",
        "SELECT\n",
        "  customer_name,\n",
        "  total_products_reduced\n",
        "FROM\n",
        "  downselling_per_month\n",
        "WHERE\n",
        "  rn = 1\n",
        "ORDER BY\n",
        "  total_products_reduced DESC\n",
        "LIMIT 10"
      ],
      "catalog": "subscription_catalog",
      "schema": "gold"
    },
    {
      "name": "b858fdc2",
      "displayName": "Top Upselling Customers",
      "queryLines": [
        "WITH customer_events AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    Month,\n",
        "    COUNT(DISTINCT product_id) AS product_count\n",
        "  FROM\n",
        "    subscription_analytics\n",
        "  WHERE\n",
        "    close_status = 'Won'\n",
        "  GROUP BY\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    Month\n",
        "),\n",
        "upselling_per_month AS (\n",
        "  SELECT\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    Month,\n",
        "    SUM(product_count) OVER (\n",
        "        PARTITION BY customer_id, customer_name\n",
        "        ORDER BY Month\n",
        "      ) AS total_products_added,\n",
        "    ROW_NUMBER() OVER (PARTITION BY customer_id, customer_name ORDER BY Month DESC) AS rn\n",
        "  FROM\n",
        "    customer_events\n",
        ")\n",
        "SELECT\n",
        "  customer_name,\n",
        "  total_products_added\n",
        "FROM\n",
        "  upselling_per_month\n",
        "WHERE\n",
        "  rn = 1\n",
        "ORDER BY\n",
        "  total_products_added DESC\n",
        "LIMIT 10"
      ],
      "catalog": "subscription_catalog",
      "schema": "gold"
    },
    {
      "name": "25f7b736",
      "displayName": "Top 10 Products by Revenue",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  SUM(revenue_in_gpb) AS total_revenue\n",
        "FROM\n",
        "  subscription_analytics\n",
        "GROUP BY\n",
        "  product_name\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ],
      "columns": [
        {
          "displayName": "Product Code",
          "description": "Short product code without CRM Module prefix",
          "expression": "REPLACE(`product_name`, 'CRM Module ', '')"
        }
      ],
      "catalog": "subscription_catalog",
      "schema": "gold"
    }
  ],
